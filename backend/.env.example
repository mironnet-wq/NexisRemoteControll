# Copie para backend/.env (não versionar) ou use como EnvironmentFile do systemd.

# Endereço de escuta. Na VM fica só local; o nginx da borda 5087 publica /nexis/.
NEXIS_BIND_HOST=127.0.0.1
NEXIS_PORT=6061

# Segredo compartilhado com o Gestor (mesmo valor de NEXIS_GESTOR_TOKEN no server/.env do Gestor).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXIS_GESTOR_TOKEN=

# Token que os coletores mandam ao conectar. Deixe vazio enquanto houver agentes antigos.
NEXIS_DEVICE_TOKEN=

# Assina o login do painel antigo.
NEXIS_SECRET_KEY=

# Painel antigo em backend/static (só para testes). 1 = liga.
NEXIS_LEGACY_PANEL=0
NEXIS_ADMIN_EMAIL=
NEXIS_ADMIN_PASSWORD=

# Host usado no QR de provisionamento.
NEXIS_SERVER_HOST=10.70.2.5:5087
